{
  "openapi": "3.1.0",
  "info": {
    "title": "Bin Buddy model API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Version",
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/answer": {
      "post": {
        "summary": "Answer",
        "operationId": "answer_answer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/verify": {
      "post": {
        "summary": "Verify",
        "operationId": "verify_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/DecisionState"
          },
          "answer": {
            "$ref": "#/components/schemas/QuestionAnswer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state",
          "answer"
        ],
        "title": "AnswerRequest"
      },
      "AnswerResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "next_question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Question"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerdictResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "AnswerResponse"
      },
      "BinQrPayload": {
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "title": "V",
            "default": 1
          },
          "bin_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Bin Id",
            "description": "Unique physical bin, e.g. 'demo-hdb-01'"
          },
          "site_policy": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Site Policy"
          },
          "bin_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Bin Key",
            "description": "Bin key in that site policy, e.g. 'blue_bin'"
          },
          "location_label": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Location Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bin_id",
          "site_policy",
          "bin_key",
          "location_label"
        ],
        "title": "BinQrPayload",
        "description": "JSON encoded in the QR code on each demonstration bin."
      },
      "Channel": {
        "type": "string",
        "enum": [
          "recycle",
          "general_waste",
          "e_waste",
          "donation",
          "abstain"
        ],
        "title": "Channel",
        "description": "Disposal channel a site bin belongs to. Site policies map channels to concrete bins."
      },
      "Condition": {
        "type": "string",
        "enum": [
          "clean",
          "food_residue",
          "leftover_liquid",
          "item_inside"
        ],
        "title": "Condition",
        "description": "Contamination state (proposal: food residue, leftover liquid, items left inside)."
      },
      "ConditionScore": {
        "properties": {
          "label": {
            "$ref": "#/components/schemas/Condition"
          },
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "probability"
        ],
        "title": "ConditionScore"
      },
      "DecisionState": {
        "properties": {
          "scan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Scan Id"
          },
          "site_policy": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Site Policy"
          },
          "material_scores": {
            "items": {
              "$ref": "#/components/schemas/MaterialScore"
            },
            "type": "array",
            "title": "Material Scores"
          },
          "condition_scores": {
            "items": {
              "$ref": "#/components/schemas/ConditionScore"
            },
            "type": "array",
            "title": "Condition Scores"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "asked": {
            "items": {
              "$ref": "#/components/schemas/QuestionAnswer"
            },
            "type": "array",
            "title": "Asked"
          },
          "signature": {
            "type": "string",
            "title": "Signature",
            "description": "HMAC-SHA256 over the other fields, hex"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scan_id",
          "site_policy",
          "material_scores",
          "condition_scores",
          "confidence",
          "signature"
        ],
        "title": "DecisionState",
        "description": "Everything needed to continue a decision. Signed by the API; tampering is rejected."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_image",
          "image_too_large",
          "invalid_state",
          "invalid_answer",
          "unknown_policy",
          "model_unavailable",
          "internal"
        ],
        "title": "ErrorCode"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "model_loaded"
        ],
        "title": "HealthResponse"
      },
      "Material": {
        "type": "string",
        "enum": [
          "paper",
          "plastic",
          "glass",
          "metal",
          "beverage_carton",
          "styrofoam",
          "e_waste",
          "textile",
          "food_waste",
          "other_general"
        ],
        "title": "Material",
        "description": "What the item is made of (proposal 1.3, 4.2)."
      },
      "MaterialScore": {
        "properties": {
          "label": {
            "$ref": "#/components/schemas/Material"
          },
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label",
          "probability"
        ],
        "title": "MaterialScore"
      },
      "PolicyVersion": {
        "properties": {
          "site": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Site"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site",
          "version"
        ],
        "title": "PolicyVersion"
      },
      "PredictRequest": {
        "properties": {
          "image_base64": {
            "type": "string",
            "title": "Image Base64"
          },
          "site_policy": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Site Policy",
            "default": "hdb_default"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image_base64"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ResponseStatus"
          },
          "next_question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Question"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerdictResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionState"
              },
              {
                "type": "null"
              }
            ]
          },
          "scan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Scan Id"
          },
          "model_revision": {
            "type": "string",
            "title": "Model Revision"
          },
          "quality": {
            "$ref": "#/components/schemas/QualityReport"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VisionAnalysis"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "scan_id",
          "model_revision",
          "quality"
        ],
        "title": "PredictResponse"
      },
      "QualityIssue": {
        "type": "string",
        "enum": [
          "too_blurry",
          "too_dark",
          "too_bright"
        ],
        "title": "QualityIssue",
        "description": "Why a photo needs a retake (proposal 1.1: too blurred or dark)."
      },
      "QualityReport": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "blur_score": {
            "type": "number",
            "minimum": 0.0,
            "title": "Blur Score",
            "description": "Variance of the Laplacian; higher is sharper"
          },
          "brightness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Brightness",
            "description": "Mean brightness, 0 = black, 1 = white"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/QualityIssue"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ok",
          "blur_score",
          "brightness"
        ],
        "title": "QualityReport"
      },
      "Question": {
        "properties": {
          "id": {
            "$ref": "#/components/schemas/QuestionId"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "options"
        ],
        "title": "Question"
      },
      "QuestionAnswer": {
        "properties": {
          "question_id": {
            "$ref": "#/components/schemas/QuestionId"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "answer"
        ],
        "title": "QuestionAnswer"
      },
      "QuestionId": {
        "type": "string",
        "enum": [
          "q1_recycling_symbol",
          "q2_cleaned",
          "q3_sitting_time"
        ],
        "title": "QuestionId",
        "description": "The fixed question bank (proposal 1.2)."
      },
      "ResponseStatus": {
        "type": "string",
        "enum": [
          "retake",
          "question",
          "verdict"
        ],
        "title": "ResponseStatus"
      },
      "VerdictResult": {
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "bin_key": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bin Key",
            "description": "Bin in the active site policy; null when abstaining"
          },
          "bin_label": {
            "type": "string",
            "title": "Bin Label"
          },
          "bin_colour": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bin Colour"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "tip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tip"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Rule Id"
          },
          "rule_trace": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Rule Trace"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "questions_asked": {
            "items": {
              "$ref": "#/components/schemas/QuestionAnswer"
            },
            "type": "array",
            "title": "Questions Asked"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "channel",
          "bin_key",
          "bin_label",
          "reason",
          "rule_id",
          "rule_trace",
          "confidence"
        ],
        "title": "VerdictResult"
      },
      "VerifyChecks": {
        "properties": {
          "image_match": {
            "type": "boolean",
            "title": "Image Match"
          },
          "bin_matches_verdict": {
            "type": "boolean",
            "title": "Bin Matches Verdict"
          },
          "within_time_window": {
            "type": "boolean",
            "title": "Within Time Window"
          },
          "not_duplicate": {
            "type": "boolean",
            "title": "Not Duplicate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image_match",
          "bin_matches_verdict",
          "within_time_window",
          "not_duplicate"
        ],
        "title": "VerifyChecks"
      },
      "VerifyRequest": {
        "properties": {
          "scan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Scan Id"
          },
          "image_base64": {
            "type": "string",
            "title": "Image Base64"
          },
          "qr": {
            "$ref": "#/components/schemas/BinQrPayload"
          },
          "recommended_site_policy": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Recommended Site Policy"
          },
          "recommended_bin_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{1,39}$",
            "title": "Recommended Bin Key"
          },
          "original_embedding": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Original Embedding"
          },
          "original_phash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "title": "Original Phash",
            "description": "64-bit perceptual hash, hex"
          },
          "original_created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Original Created At"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "known_phashes": {
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$",
              "description": "64-bit perceptual hash, hex"
            },
            "type": "array",
            "title": "Known Phashes",
            "description": "Recent hashes for this user, for duplicate detection"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scan_id",
          "image_base64",
          "qr",
          "recommended_site_policy",
          "recommended_bin_key",
          "original_embedding",
          "original_phash",
          "original_created_at",
          "submitted_at"
        ],
        "title": "VerifyRequest"
      },
      "VerifyResponse": {
        "properties": {
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "similarity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Similarity"
          },
          "checks": {
            "$ref": "#/components/schemas/VerifyChecks"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "phash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "title": "Phash",
            "description": "64-bit perceptual hash, hex"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "passed",
          "similarity",
          "checks",
          "reason",
          "phash"
        ],
        "title": "VerifyResponse"
      },
      "VersionResponse": {
        "properties": {
          "model_repo": {
            "type": "string",
            "title": "Model Repo"
          },
